@model Foku.Models.Usuario
@{
    ViewData["Title"] = "Perfil";
    Layout = null;
    var nombreInicial = !string.IsNullOrWhiteSpace(Model?.Nombre) ? Model.Nombre : "Usuario";
    var usernameInicial = !string.IsNullOrWhiteSpace(Model?.Username) ? Model.Username : "usuario";
    var mensajeExito = TempData["SuccessPerfil"] as string;
    var mensajeError = TempData["ErrorPerfil"] as string;
    var mensajeErrorPassword = TempData["ErrorPassword"] as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil | Foku</title>
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true" />
    <script src="~/js/Perfil.js" asp-append-version="true" defer></script>
</head>

<body class="perfil-page">
    <header class="perfil-header">
        <div class="perfil-brand">
            <a asp-controller="Home" asp-action="VistaLanding" aria-label="Ir a la landing">
                <img src="~/images/LogoCompleto.png" alt="Foku" />
            </a>
        </div>

        <nav class="perfil-nav" aria-label="Navegación del perfil">
            <a class="perfil-btn-secondary" asp-controller="Home" asp-action="Index">Volver al workspace</a>
            <a class="perfil-btn-secondary" asp-controller="Home" asp-action="VistaLanding">Landing</a>
        </nav>
    </header>

    <main class="perfil-main">
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <p class="perfil-mensaje perfil-mensaje-exito">
            @mensajeExito
        </p>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <p class="perfil-mensaje perfil-mensaje-error">
            @mensajeError
        </p>
    }
        <section class="perfil-card" aria-label="Información del usuario">
            <div class="perfil-user-info">
            <div class="perfil-avatar">
                @if (!string.IsNullOrWhiteSpace(Model.FotoPerfil))
                {
                    <img src="@Model.FotoPerfil" alt="Foto de perfil" />
                }
                else
                {
                    @nombreInicial.Substring(0, 1).ToUpperInvariant()
                }
                </div>
                <div class="perfil-user-meta">
                    <h1>@nombreInicial</h1>
                    <p>@@@usernameInicial</p>
                </div>
            </div>
            <button type="button" class="perfil-edit-button" onclick="openPerfilModal()"> Editar perfil</button>
        </section>


        <!-- SECCIÓN INFERIOR DEL PERFIL -->

        <div class="profile-content">

            <!-- COLUMNA IZQUIERDA -->
            <div class="profile-left">

                <!-- RACHA: ACÁ VA LA FOTO DE RACHA -->
                <div class="profile-racha">
                    <h2>Racha</h2>

                    <!-- ACÁ VA EL CONTENIDO DE RACHA -->
                </div>

                <!-- ESTADÍSTICAS: ACÁ VA LA FOTO DE ESTADÍSTICAS -->
                <div class="profile-estadisticas">
                    <h2>Estadísticas</h2>

                    <!-- ACÁ VA EL CONTENIDO DE ESTADÍSTICAS -->
                </div>

            </div>

            <!-- COLUMNA DERECHA: TIENDA -->
            <div class="profile-tienda">

                <!-- ENCABEZADO DE TIENDA -->
                <div class="profile-tienda-header">
                    <h2>Tienda</h2>

                    <button type="button"
                            class="profile-tienda-carrito"
                            onclick="abrirTienda()">
                        <img src="~/images/tienda_carrito.png" alt="Abrir tienda" />
                    </button>
                </div>

                <!-- LÍNEA DIVISORIA -->
                <div class="profile-tienda-linea"></div>

                <!-- INTERIOR BLANCO -->
                <div class="profile-tienda-interior">

                    <!-- MENSAJE CUANDO TODAVÍA NO HAY UN FONDO -->
                    <div class="profile-tienda-vacio">
                        ¡Cómprate y equípate un fondo para empezar a personalizar tu espacio!
                    </div>

                </div>

            </div>

        </div>

        <!-- POPUP DE TIENDA: FUERA DE PROFILE-CONTENT -->
        <div id="tiendaModal" class="tienda-modal-backdrop">
            <div class="tienda-modal" role="dialog" aria-modal="true" aria-labelledby="tiendaModalTitle">

                <div class="tienda-modal-header">
                    <h2 id="tiendaModalTitle">Tienda</h2>

                    <button type="button" class="tienda-modal-close" onclick="cerrarTienda()">
                        &times;
                    </button>
                </div>

                <div class="tienda-modal-body">
                    <!-- CONTENIDO DE LA TIENDA MÁS ADELANTE -->
                </div>

            </div>
        </div>


        <div id="perfilModal" class="perfil-modal-backdrop" aria-hidden="true">
        <div class="perfil-modal" role="dialog" aria-modal="true" aria-labelledby="perfilModalTitle">
            <h3 id="perfilModalTitle">Editar perfil</h3>

            <!-- Foto y datos actuales -->
            <div class="perfil-modal-user">
                <div class="perfil-modal-avatar">
                    @if (!string.IsNullOrWhiteSpace(Model.FotoPerfil))
                    {
                        <img src="@Model.FotoPerfil" alt="Foto de perfil" />
                    }
                    else
                    {
                        @nombreInicial.Substring(0, 1).ToUpperInvariant()
                    }
                </div>

                <div class="perfil-modal-user-info">
                    <strong>@nombreInicial</strong>
                    <span>@@@usernameInicial</span>
                </div>
            </div>

            <!-- Formulario para cambiar foto -->
            <div class="perfil-modal-photo-actions">

                <form asp-controller="Usuario"
                    asp-action="CambiarFotoPerfil"
                    method="post"
                    enctype="multipart/form-data"
                    id="formFotoPerfil"
                    class="perfil-foto-form">

                    <label for="inputFotoPerfil" class="perfil-btn-secondary">
                        Cambiar foto
                    </label>

                    <input type="file"
                        id="inputFotoPerfil"
                        name="foto"
                        accept="image/*"
                        hidden />
                </form>

                <button type="button"
                        class="perfil-btn-secondary"
                        onclick="openPasswordModal()">
                    Cambiar contraseña
                </button>

            </div>

            <!-- Único formulario para editar nombre y usuario -->
            <form asp-controller="Usuario"
                asp-action="EditarPerfil"
                method="post"
                class="perfil-modal-form"
                id="modalPerfilForm"
                data-usuario-actual="@Model.Username">

                <div class="perfil-field">
                    <label for="modalNombre">Nombre</label>
                    <input id="modalNombre" name="nombre" type="text" value="@Model.Nombre" required />
                </div>

                <div class="perfil-field">
                    <label for="modalUsuario">Nombre de usuario</label>
                    <input id="modalUsuario" name="nombreUsuario" type="text" value="@Model.Username" required />
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <p class="perfil-mensaje perfil-mensaje-error">
                        @mensajeError
                    </p>
                }

                <div class="perfil-modal-actions">
                    <button type="button" class="perfil-btn-secondary" onclick="closePerfilModal()">Cancelar</button>
                    <button type="submit" class="perfil-submit-btn">Guardar</button>
                </div>
            </form>
        </div>
        </div>

        <!-- Popup para cambiar contraseña -->
        <div id="passwordModal" class="perfil-modal-backdrop">
            <div class="perfil-modal password-modal">
                <h3 id="passwordModalTitle">Cambiar contraseña</h3>
                <p class="password-description"> Elegí una contraseña segura para proteger tu cuenta.</p>

                <form asp-controller="Usuario"
                    asp-action="CambiarContraseña"
                    method="post"
                    id="formCambiarPassword"
                    class="perfil-modal-form">

                    <div class="perfil-field">
                        <label for="nuevaContraseña">Nueva contraseña</label>

                        <div class="password-input-container">
                            <input type="password"
                                id="nuevaContraseña"
                                name="nuevaContraseña"
                                autocomplete="new-password"
                                required />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="mostrarOcultarPassword('nuevaContraseña', this)">
                                Mostrar
                            </button>
                        </div>

                        <p id="passwordAyuda" class="password-help">Mínimo 8 caracteres, con letras y números.</p>
                    </div>

                    <div class="perfil-field">
                        <label for="confirmarContraseña">Confirmar nueva contraseña</label>

                        <div class="password-input-container">
                            <input type="password"
                                id="confirmarContraseña"
                                name="confirmarContraseña"
                                autocomplete="new-password"
                                required />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="mostrarOcultarPassword('confirmarContraseña', this)">
                                Mostrar
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeErrorPassword))
                    {
                        <p id="errorPassword" class="password-error">@mensajeErrorPassword</p>
                    }
                    else
                    {
                        <p id="errorPassword" class="password-error" style="display: none;"></p>
                    }

                    <div class="perfil-modal-actions">
                        <button type="button"
                                class="perfil-btn-secondary"
                                onclick="cancelarPasswordModal()">
                            Cancelar
                        </button>

                        <button type="submit" class="perfil-submit-btn">Guardar contraseña</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Cerrar sesión -->
        <form class="perfil-logout-form"
            asp-controller="Usuario"
            asp-action="CerrarSesion"
            method="post"
            id="formCerrarSesion">
            <button type="button" class="perfil-logout-btn" onclick="openCerrarSesionModal()">Cerrar sesión</button>
        </form>

        <!-- Pop-up de confirmación -->
        <div id="cerrarSesionModal" class="cerrar-sesion-backdrop" aria-hidden="true">
            <div class="cerrar-sesion-modal"
                role="dialog"
                aria-modal="true"
                aria-labelledby="cerrarSesionTitle">
                <h3 id="cerrarSesionTitle">¿Estás seguro de que querés cerrar sesión?</h3>
                <p>Tu sesión se va a cerrar, pero no te preocupes: vas a poder volver a Foku cuando quieras. Tus datos y tu progreso seguirán guardados.</p>
                <div class="cerrar-sesion-actions">
                    <button type="button" class="cerrar-sesion-cancelar" onclick="closeCerrarSesionModal()"> Cancelar</button>
                    <button type="button" class="cerrar-sesion-continuar" onclick="confirmarCerrarSesion()"> Continuar</button>
                </div>
            </div>
        </div>
    </main>

</body>
</html>
