@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="seccionblanca contenedorCentrado">
    <a href='@Url.Action("VistaLanding", "Home")'>
        <button class="btnBlackOutline btnArribaIzquierda">Volver</button>
    </a>
    <div class="contenedorCentrado tarjeta tarjetaLog">
        <h2 class="subtitulo-2">Registrarse</h2>
        <form method="post" action="@Url.Action("RegistrarDatos", "Usuario")" class="formLog" onsubmit="return validarCampos();">
        <div>
            <label for="nombreUsuario">Nombre de Usuario</label>
            <input type="text" id="nombreUsuario" name="nombreUsuario" required>
        </div>
        <div>
            <label for="contraseña">Contraseña</label>
            <input type="password" id="contraseña" name="contraseña" required>
        </div>
        <div>
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" required>
        </div>
        <div>
            <label for="apellido">Apellido</label>
            <input type="text" id="apellido" name="apellido" required>
        </div>
        <div>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>
        </div>
        <div class="checkbox-container">
            <input type="checkbox" id="aceptoTerminos" name="aceptoTerminos" required>
            <label for="aceptoTerminos">Acepto los términos y condiciones</label>
        </div>
        <button type="submit" class="btnAcento">Registrarse</button>
        </form>
    </div>
    <p>¿Ya tienes una cuenta? <a href="@Url.Action(action: "VistaIniciarSesion", controller: "Usuario")">Inicia sesión</a></p>
</section>