@using Foku.Models
@using System.Text.Json
@using Google.Apis.Calendar.v3.Data
@{
    ViewData["Title"] = "Foku";
    Layout = null;
    Usuario usuario = ViewBag.user as Usuario;
    var tareasCalendario = ViewBag.tareas as IEnumerable<Foku.Models.Tarea> ?? new List<Foku.Models.Tarea>();
    var tareasJson = tareasCalendario
        .Where(t => t != null && !string.IsNullOrWhiteSpace(t.Nombre))
        .Select(t => new {
            id = t.Id,
            title = t.Nombre,
            start = (t.FechaLimite ?? t.Fecha ?? DateTime.Today).ToString("yyyy-MM-dd"),
            allDay = true,
            backgroundColor = t.Terminada ? "#76c893" : "#FF9509",
            borderColor = t.Terminada ? "#76c893" : "#FF9509",
            extendedProps = new {
                descripcion = t.Descripcion ?? string.Empty,
                terminada = t.Terminada
            }
        })
        .ToList();

    var eventosModel = ViewBag.eventos as Events;
    var eventosJson = eventosModel?.Items != null && eventosModel.Items.Any()
        ? JsonSerializer.Serialize(eventosModel.Items.Select(e => {
            var startValue = e.Start != null
                ? (e.Start.DateTime.HasValue ? e.Start.DateTime.Value.ToString("yyyy-MM-ddTHH:mm:ss") : e.Start.Date ?? DateTime.MinValue.ToString("yyyy-MM-dd"))
                : DateTime.MinValue.ToString("yyyy-MM-dd");

            var endValue = e.End != null
                ? (e.End.DateTime.HasValue ? e.End.DateTime.Value.ToString("yyyy-MM-ddTHH:mm:ss") : e.End.Date ?? DateTime.MinValue.ToString("yyyy-MM-dd"))
                : DateTime.MinValue.ToString("yyyy-MM-dd");

            return new {
                id = e.Id,
                title = e.Summary ?? "Evento",
                start = startValue,
                end = endValue,
                allDay = e.Start?.Date != null || e.End?.Date != null,
                color = "#7c80ff"
            };
        }))
        : JsonSerializer.Serialize(new[] {
            new {
                id = "demo-1",
                title = "Reunión de equipo",
                start = DateTime.Now.AddDays(1).Date.AddHours(9).AddMinutes(30).ToString("yyyy-MM-ddTHH:mm:ss"),
                end = DateTime.Now.AddDays(1).Date.AddHours(10).AddMinutes(45).ToString("yyyy-MM-ddTHH:mm:ss"),
                allDay = false,
                color = "#7c80ff"
            },
            new {
                id = "demo-2",
                title = "Entrega del proyecto",
                start = DateTime.Now.AddDays(3).ToString("yyyy-MM-dd"),
                end = DateTime.Now.AddDays(4).ToString("yyyy-MM-dd"),
                allDay = true,
                color = "#7c80ff"
            },
            new {
                id = "demo-3",
                title = "Revisión semanal",
                start = DateTime.Now.AddDays(5).Date.AddHours(15).ToString("yyyy-MM-ddTHH:mm:ss"),
                end = DateTime.Now.AddDays(5).Date.AddHours(16).AddMinutes(30).ToString("yyyy-MM-ddTHH:mm:ss"),
                allDay = false,
                color = "#7c80ff"
            }
        });
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foku App</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />
    <link rel="stylesheet" href="~/css/workspace.css">
    <link rel="stylesheet" href="~/css/workspace-calendario.css">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        .workspace-user-group {
            position: relative;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .workspace-user-button {
            background: transparent;
            border: none;
            cursor: pointer;
            font: inherit;
            color: #212225;
            font-weight: 700;
            padding: 0.4rem 0.6rem;
            border-radius: 999px;
        }

        .workspace-user-button:hover {
            background: rgba(33, 34, 37, 0.04);
        }

        .workspace-user-popover {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            background: #FCFBF8;
            border: 1px solid #e7e2d8;
            border-radius: 14px;
            box-shadow: 0 12px 24px rgba(0,0,0,0.12);
            min-width: 180px;
            display: none;
            z-index: 30;
        }

        .workspace-user-popover.open {
            display: block;
        }

        .workspace-user-popover a,
        .workspace-user-popover form button {
            display: block;
            width: calc(100% - 6px);
            margin: 3px;
            box-sizing: border-box;
            border: none;
            background: transparent;
            text-align: left;
            text-decoration: none;
            color: #212225;
            padding: 0.9rem 1.1rem;
            font-size: 1.05rem;
            font-weight: 600;
            border-radius: 9px;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .workspace-user-popover form {
            margin: 0;
        }

        .workspace-user-popover a:hover,
        .workspace-user-popover form button:hover {
            background: #EAEAEA;
        }

        .workspace-user-popover a:active,
        .workspace-user-popover form button:active {
            background: #CCCCCC;
        }

        /* Estilos para el widget del calendario */

        .calendar-controls {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem;
        }

        .calendar-controls select {
            padding: 0.25rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: white;
            color: #333;
        }

        #calendar-container {
            
        }

        /* Estilos para el widget de tareas */
        .tasks-widget {
            /* Estilos generales para el widget de tareas */
        }

        .task-widget-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.9rem 1rem 0.7rem;
            border-bottom: 1px solid #d8d1c8;
            background: rgba(255,255,255,0.08);
        }

        .task-header-controls {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .task-header-controls select {
            padding: 0.55rem 0.9rem;
            border: 1px solid #d5cfc5;
            border-radius: 999px;
            background: rgba(255,255,255,0.4);
            color: #2b2b2b;
            font-size: 0.95rem;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            cursor: pointer;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);
        }

        .tasks-widget-body {
            padding: 0.9rem 1rem 1rem;
            background: rgba(255,255,255,0.04);
        }

        .task-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.9rem;
        }

        #task-search {
            flex: 1;
            padding: 0.7rem 0.9rem;
            border: 1px solid #d5d0c8;
            border-radius: 12px;
            background: rgba(255,255,255,0.5);
            color: #333;
            font-size: 0.95rem;
        }

        .task-add-button {
            padding: 0.75rem 1rem;
            border: 1px solid #d4d0c9;
            border-radius: 12px;
            background: rgba(255,255,255,0.25);
            color: #2c2c2c;
            font-weight: 700;
            cursor: pointer;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);
        }

        .task-add-button:hover {
            background: rgba(255,255,255,0.35);
        }

        .task-add-form {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;
            margin-bottom: 1rem;
            padding: 0.8rem;
            border: 1px solid #d8d0c8;
            border-radius: 18px;
            background: rgba(255,255,255,0.18);
            width: 100%;
            min-width: 0;
        }

        .task-add-form input,
        .task-add-form textarea {
            padding: 0.8rem 0.9rem;
            border: 1px solid #d3ccc2;
            border-radius: 12px;
            background: rgba(255,255,255,0.5);
            color: #333;
            width: 100%;
            min-width: 0;
            font: inherit;
            resize: vertical;
        }

        .task-deadline-field {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            width: 100%;
            min-width: 0;
            color: #585858;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .task-deadline-field input[type="date"] {
            width: 100%;
            min-width: 0;
            min-height: 42px;
            resize: none;
        }

        .task-form-actions {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 0.7rem;
        }

        .task-form-cancel,
        .task-form-save {
            padding: 0.6rem 1rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
        }

        .task-form-cancel {
            background: #6c757d;
            color: white;
        }

        .task-form-cancel:hover {
            background: #5a6268;
        }

        .task-form-save {
            background: #4f7dbe;
            color: white;
        }

        .task-form-save:hover {
            background: #436fa9;
        }

        .tasks-list-container {
            max-height: 370px;
            overflow-y: auto;
            padding: 0.2rem 0.1rem 0.1rem;
        }

        .task-item {
            padding: 1rem 0.9rem;
            border: 1px solid #d9d1c7;
            border-radius: 18px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.9rem;
            background: rgba(255,255,255,0.18);
            margin-bottom: 0.75rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
        }

        .task-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

        .task-item.completed {
            color: #5f5f5f;
            background: rgba(255,255,255,0.12);
        }

        .task-item.completed .task-name {
            text-decoration: line-through;
        }

        .task-item.completed .task-description,
        .task-item.completed .task-tags,
        .task-item.completed .task-item-actions,
        .task-item.completed .task-tag-add,
        .task-item.completed .task-tag-remove,
        .task-item.completed .task-delete-btn,
        .task-item.completed .task-edit-btn,
        .task-item.completed input[type="checkbox"] {
            text-decoration: none;
        }

        .task-item input[type="checkbox"] {
            margin-top: 0.2rem;
            width: 1rem;
            height: 1rem;
            accent-color: #5d7faf;
        }

        .task-main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .task-title-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .task-name {
            font-size: 1.08rem;
            font-weight: 700;
            color: #2d2d2d;
            word-break: break-word;
        }

        .task-description {
            font-size: 0.92rem;
            color: #585858;
            line-height: 1.45;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .task-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
            align-items: center;
            margin-top: 0.2rem;
        }

        .task-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.32rem 0.65rem;
            border-radius: 999px;
            border: 1px solid rgba(0,0,0,0.08);
            color: #2f3c4c;
            font-size: 0.78rem;
            font-weight: 600;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);
        }

        .task-tag-remove,
        .task-tag-option-remove,
        .task-tag-option-edit {
            border: none;
            background: transparent;
            cursor: pointer;
            color: inherit;
            font: inherit;
            opacity: 0.9;
        }

        .task-tag-add {
            border: 1px solid #d3d8e1;
            background: rgba(255,255,255,0.26);
            color: #3d4c5f;
            border-radius: 999px;
            padding: 0.35rem 0.7rem;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
        }

        .task-item-actions {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-shrink: 0;
        }

        .task-edit-btn,
        .task-delete-btn {
            padding: 0.45rem 0.7rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            color: white;
            font-weight: 600;
            font-size: 0.82rem;
            transition: background-color 0.2s ease, color 0.2s ease, text-shadow 0.2s ease;
        }

        .task-edit-btn {
            background: #5a7dbb;
        }

        .task-edit-btn:hover {
            background: #4d6ea7;
        }

        .task-delete-btn {
            background: #d76767;
        }

        .task-delete-btn:hover {
            background: #bf5656;
        }

        .task-delete-confirming {
            background: #b84d4d;
            box-shadow: 0 0 0 2px rgba(184, 77, 77, 0.18);
        }

        .task-action-btn {
            padding: 0.25rem 0.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            background: #007bff;
            color: white;
        }

        .task-action-btn:hover {
            background: #0056b3;
        }

        /* Estilos para el modal de etiquetas */
        .task-tag-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .task-tag-modal-backdrop {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(37, 42, 51, 0.38);
        }

        .task-tag-modal-dialog {
            position: relative;
            background: #f3efe9;
            border-radius: 24px;
            overflow: hidden;
            max-width: 540px;
            width: 100%;
            border: 1px solid #d8d2c9;
            box-shadow: 0 12px 28px rgba(35, 39, 43, 0.18);
        }

        .task-tag-modal-header {
            padding: 1.05rem 1.2rem 0.9rem;
            background: transparent;
            border-bottom: 1px solid #d8d1c8;
        }

        .task-tag-modal-title {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
            color: #2d2d2d;
        }

        .task-tag-modal-close {
            position: absolute;
            top: 0.7rem;
            right: 0.8rem;
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 2rem;
            line-height: 1;
            color: #2d2d2d;
        }

        .task-tag-modal-options {
            padding: 1rem 1.1rem 1.1rem;
        }

        .task-tag-creator,
        .task-tag-edit-panel {
            margin-bottom: 1rem;
            padding: 0.9rem;
            border: 1px solid #d8d0c8;
            border-radius: 16px;
            background: rgba(255,255,255,0.2);
        }

        .task-tag-form-row,
        .task-tag-edit-row {
            display: flex;
            gap: 0.75rem;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .task-tag-new-name,
        .task-tag-edit-name {
            flex: 1;
            padding: 0.7rem 0.8rem;
            border: 1px solid #d3ccc2;
            border-radius: 10px;
            background: rgba(255,255,255,0.5);
        }

        .task-tag-new-color,
        .task-tag-edit-color {
            width: 52px;
            height: 38px;
            border: none;
            background: transparent;
            padding: 0;
            cursor: pointer;
        }

        .task-tag-create-button,
        .task-tag-edit-save {
            width: 100%;
            border: none;
            border-radius: 10px;
            background: #5a7dbb;
            color: white;
            padding: 0.7rem 0.9rem;
            cursor: pointer;
            font-weight: 700;
            transition: background-color 0.2s ease;
        }

        .task-tag-create-button:hover,
        .task-tag-edit-save:hover {
            background: #4d6ea7;
        }

        .task-tag-edit-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.5rem;
            margin-top: 0.75rem;
        }

        .task-tag-edit-cancel {
            border: none;
            border-radius: 10px;
            padding: 0.65rem 0.8rem;
            cursor: pointer;
            font-weight: 700;
            background: #6c757d;
            color: white;
            transition: background-color 0.2s ease;
        }

        .task-tag-edit-cancel:hover {
            background: #5a6268;
        }

        .task-tag-list {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .task-tag-option {
            padding: 0.7rem 0.75rem;
            cursor: pointer;
            transition: background 0.2s ease, border-color 0.2s ease;
            border: 1px solid #d9d0c6;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-align: left;
            background: rgba(255,255,255,0.18);
            width: 100%;
            color: #2d2d2d;
        }

        .task-tag-option:hover {
            background: rgba(255,255,255,0.28);
        }

        .task-tag-option .task-tag-option-remove,
        .task-tag-option .task-tag-option-edit {
            margin-left: auto;
            font-size: 0.8rem;
            border-radius: 8px;
            padding: 0.25rem 0.45rem;
            background: rgba(255,255,255,0.32);
        }

        /* Estilos para el popup del calendario */
        #calendar-popup {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            z-index: 1001;
            display: flex;
            flex-direction: column;
            width: 90%;
            max-width: 600px;
            background-color: var(--cards);
        }

        #calendar-popup.hidden {
            display: none !important;
        }

        #calendar-popup-header {
            padding: 1rem;
            background: #f1f1f1;
            border-bottom: 1px solid #e7e2d8;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #calendar-popup-title {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 500;
        }

        #calendar-popup-close {
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 1.5rem;
            line-height: 1;
        }

        #calendar-popup-body {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        #calendar-event-form {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        #calendar-event-form input,
        #calendar-event-form textarea {
            padding: 0.5rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: white;
            color: #333;
            width: 100%;
        }

        #calendar-event-form button {
            padding: 0.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            background: var(--secundario-i-rest);
            color: white;
            font-weight: 600;
        }

        /* Estilos para el fondo del popup del calendario */
        .calendar-popup-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 1000;
            display: none;
        }

        /* Estilos específicos para el widget de calendario en el popup */
        .calendar-widget {
            display: flex;
            flex-direction: column;
            width: 100%;
        }

        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem;
            border-bottom: 1px solid #e7e2d8;
        }

        .calendar-title {
            font-size: 1.25rem;
            font-weight: 500;
            margin: 0;
        }

        .calendar-controls {
            display: flex;
            gap: 0.5rem;
        }

        .calendar-controls select {
            padding: 0.25rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: white;
            color: #333;
            padding-left: 0.7rem;
        }

        .calendar-controls input[type="number"] {
            width: 50%;
            padding: 0.25rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: white;
            color: #333;
            min-height: 32px;
            padding-left: 0.7rem;
        }

        .calendar-weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        

        .calendar-event {
            color: var(--black-rest);
            padding: 0.25rem;
            border-radius: 4px;
            margin-top: 0.25rem;
            font-size: 0.875rem;
            cursor: pointer;
        }

        .calendar-event:hover {
            color: var(--black-rest);
        }

        .workspace-user-button {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .workspace-user-avatar {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border-radius: 50%;
            overflow: hidden;
            background: #FF9509;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .workspace-user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
</head>
<body>
    <!-- Header superior -->
    <header id="workspace-header">
        <div>
            <a asp-controller="Home" asp-action="VistaLanding" aria-label="Ir a la landing" style="display:flex; align-items:center; text-decoration:none; color:inherit;">
                <img src="/images/logo.png" alt="Foku Logo" />
                <h1>Foku</h1>
            </a>
        </div>
        <div>
            <!-- Agregado id="tour-racha" -->
            <div id="tour-racha">
                <h2>@(usuario?.Racha ?? 0)</h2>
                <img src="/images/racha.png" alt="Racha">
            </div>
            <div class="workspace-user-group">
                <button type="button" class="workspace-user-button" onclick="toggleWorkspaceUserMenu()">
                    <span class="workspace-user-avatar">
                        @if (!string.IsNullOrWhiteSpace(usuario?.FotoPerfil))
                        {
                            <img src="@usuario.FotoPerfil" alt="Foto de perfil" />
                        }
                        else
                        {
                            @(string.IsNullOrWhiteSpace(usuario?.Username) ? "U" : usuario.Username.Substring(0, 1).ToUpperInvariant())
                        }
                    </span>
                    <span>@(usuario?.Username ?? "Usuario")</span>
                </button>
                <div id="workspaceUserMenu" class="workspace-user-popover">
                    <a asp-controller="Usuario" asp-action="Perfil">Ir al perfil</a>
                    <form asp-controller="Usuario" asp-action="CerrarSesion" method="post">
                        <button type="submit">Cerrar sesión</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- Cuerpo principal -->
    <main>
        <aside id="workspace-sidebar">
            <nav>
                <ul>
                    <!-- Agregado id="tour-documentos" -->
                    <li>
                        <button id="tour-documentos">
                            <img src="~/images/documents-icon.png" alt="Documents Icon" class="sidebar-icon-img" />
                            <p>Documentos</p>
                        </button>
                    </li>
                    <!-- Agregado id="tour-pomodoro" -->
                    <li>
                        <button id="btn-pomodoro" id-tour="tour-pomodoro" onclick="abrirPomodoro()">
                            <img src="/images/pomodoro-icon.png" alt="Pomodoro Icon" class="sidebar-icon-img" />
                            <p>Pomodoro</p>
                        </button>
                    </li>
                    <!-- Agregado id="tour-tareas" -->
                    <li>
                        <button id="tour-tareas" onclick="abrirTareas()">
                            <img src="/images/tasks-icon.png" alt="Tasks Icon" class="sidebar-icon-img" />
                            <p>Tareas</p>
                        </button>
                    </li>
                    <!-- Agregado id="tour-calendario" -->
                    <li>
                        <button id="tour-calendario" onclick="abrirCalendario()">
                            <img src="~/images/calendar-icon.png" alt="Calendar Icon" class="sidebar-icon-img" />
                            <p>Calendario</p>
                        </button>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Zona de trabajo -->
        <div class="workspace-area">
            <!-- Widget Flotante: Pomodoro -->
            <div id="pomodoro-widget" class="floating-widget hidden">
                <div class="widget-header">
                    <div class="title-container">
                        <h3>Pomodoro</h3>
                        <img src="~/images/infoIcon.png" class="info-icon" alt="?InfoIcon" />
                    </div>
                    <div class="header-actions">
                        <button class="config-icon" onclick="toggleConfigPanel()" title="Personalizar tiempos">
                            <img src="/images/config.png"/>
                        </button>
                        <button class="minimize-btn" onclick="minimizarPomodoro()" title="Minimizar">–</button>
                        <button class="open-btn" onclick="restaurarPomodoro()" title="Abrir">+</button>
                        <button class="close-btn" onclick="cerrarPomodoro()" title="Cerrar">&times;</button>
                    </div>
                </div>

                <p class="info-tooltip">
                    El pomodoro es una técnica donde hay 25 minutos de concentración y 5 minutos de descanso. Con 4 ciclos de concentración hay un descanso largo.
                </p>

                <div class="config-dropdown" id="configPanel">
                    <div class="config-header">
                        <h1>Configurar modo:</h1>
                        <div class="config-mode-options" role="group" aria-label="Seleccionar modo para configurar">
                            <button type="button" class="config-mode-btn active" data-mode="concentracion" aria-pressed="true" onclick="seleccionarModoConfiguracion('concentracion')">Concentración</button>
                            <button type="button" class="config-mode-btn" data-mode="pausaCorta" aria-pressed="false" onclick="seleccionarModoConfiguracion('pausaCorta')">Pausa corta</button>
                            <button type="button" class="config-mode-btn" data-mode="pausalarga" aria-pressed="false" onclick="seleccionarModoConfiguracion('pausalarga')">Pausa larga</button>
                        </div>
                    </div>
                    <div class="config-body">
                        <div class="config-inputs">
                            <div>
                                <input type="number" id="input-custom-min" value="25" min="0" max="99" oninput="updateCustomDurations()">
                                <p>m</p>
                            </div>
                            <span>:</span>
                            <div>
                                <input type="number" id="input-custom-sec" value="0" min="0" max="59" oninput="updateCustomDurations()">
                                <p>s</p>
                            </div>
                        </div>
                    </div>
                    <!-- RECOMENDACIÓN TIEMPO -->
                    <p id="config-recommendation" class="config-recommendation-text">
                        Recomendación: Pausa corta 5m 0s | Pausa larga 20m 0s
                    </p>
                </div>

                <div class="widget-body">
                    <div class="timer-main-row">
                        <div class="timer-display-block">
                            <h2 id="timer-display">25:00</h2>
                            <div class="timer-progress" aria-label="Progreso del pomodoro">
                                <div id="timer-progress-fill" class="timer-progress-fill"></div>
                            </div>
                        </div>
                        <div class="actions-col">
                            <button id="btn-toggle-timer" class="btn-main-action" onclick="toggleTimer()">Empezar</button>
                            <button id="btn-reset-timer" class="btn-reset" onclick="resetTimer()">Reiniciar</button>
                        </div>
                    </div>

                    <div class="next-cycle-info">
                        <p id="next-cycle-label" class="next-cycle-text">Próximo ciclo: 5 minutos de descanso</p>
                        <span class="cycle-count-badge" id="cycleBadge">Ciclo #1</span>
                    </div>

                    <div class="pomodoro-tabs">
                        <button class="tab-btn active" id="mode-concentracion" onclick="seleccionarModoManual('concentracion')">Concentración</button>
                        <button class="tab-btn" id="mode-pausaCorta" onclick="seleccionarModoManual('pausaCorta')">Pausa corta</button>
                        <button class="tab-btn" id="mode-pausalarga" onclick="seleccionarModoManual('pausalarga')">Pausa larga</button>
                    </div>
                </div>
            </div>

            <!-- Widget Flotante: Tareas -->
            <div id="tasks-widget" class="floating-widget tasks-widget hidden">
                <div class="widget-header task-widget-header">
                    <div class="title-container">
                        <h3>Tareas</h3>
                    </div>
                    <div class="task-header-controls">
                        <select id="task-tag-filter" aria-label="Filtrar por etiquetas">
                            <option value="">Etiquetas</option>
                        </select>
                        <select id="task-status-filter" aria-label="Filtrar por estado">
                            <option value="">Filtros</option>
                            <option value="false">Sin terminar</option>
                            <option value="true">Terminadas</option>
                        </select>
                        <button class="close-btn" onclick="cerrarTareas()" title="Cerrar">&times;</button>
                    </div>
                </div>

                <div class="tasks-widget-body">
                    <div class="task-toolbar">
                        <input id="task-search" type="text" placeholder="Buscar por nombre o descripción" aria-label="Buscar tarea" />
                        <button id="task-add-button" type="button" class="btn-main-action task-add-button">Agregar tarea</button>
                    </div>

                    <div id="task-add-form" class="task-add-form hidden">
                        <input id="new-task-name" type="text" placeholder="Nombre de la tarea" maxlength="255" aria-describedby="new-task-name-error" />
                        <p id="new-task-name-error" class="task-name-error hidden" role="alert"></p>
                        <textarea id="new-task-description" rows="3" placeholder="Descripcion"></textarea>
                        <label class="task-deadline-field" for="new-task-deadline">
                            Fecha límite
                            <input id="new-task-deadline" type="date" min="1753-01-01" />
                        </label>
                        <div class="task-form-actions">
                            <button type="button" class="task-form-cancel">Cancelar</button>
                            <button type="button" class="task-form-save">Guardar</button>
                        </div>
                    </div>

                    <div id="task-tag-modal" class="task-tag-modal hidden" aria-hidden="true">
                        <div class="task-tag-modal-backdrop" data-close-tag-modal="true"></div>
                        <div class="task-tag-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="task-tag-modal-title">
                            <div class="task-tag-modal-header">
                                <h4 id="task-tag-modal-title">Etiquetas</h4>
                                <button type="button" class="task-tag-modal-close" aria-label="Cerrar" data-close-tag-modal="true">&times;</button>
                            </div>
                            <div class="task-tag-modal-options">
                                <div class="task-tag-creator">
                                    <div class="task-tag-form-row">
                                        <input id="task-tag-new-name" class="task-tag-new-name" type="text" maxlength="50" placeholder="Nombre de la etiqueta" />
                                        <input id="task-tag-new-color" class="task-tag-new-color" type="color" value="#7c5cff" aria-label="Color de la etiqueta" />
                                    </div>
                                    <button type="button" id="task-tag-create-button" class="task-tag-create-button">Crear etiqueta</button>
                                </div>

                                <div id="task-tag-edit-panel" class="task-tag-edit-panel hidden">
                                    <h5 class="task-tag-edit-header">Editar etiqueta</h5>
                                    <div class="task-tag-edit-row">
                                        <input id="task-tag-edit-name" class="task-tag-edit-name" type="text" maxlength="50" placeholder="Nombre de la etiqueta" />
                                        <input id="task-tag-edit-color" class="task-tag-edit-color" type="color" value="#7c5cff" aria-label="Color de la etiqueta" />
                                    </div>
                                    <div class="task-tag-edit-actions">
                                        <button type="button" id="task-tag-edit-cancel" class="task-tag-edit-cancel">Cancelar</button>
                                        <button type="button" id="task-tag-edit-save" class="task-tag-edit-save">Guardar</button>
                                    </div>
                                </div>

                                <div id="task-tag-modal-options-list" class="task-tag-list"></div>
                            </div>
                        </div>
                    </div>

                    <div id="tasks-list-container" class="tasks-list-container" aria-live="polite"></div>
                </div>
            </div>

            <!-- Popup del calendario -->
            <div id="calendar-popup" class="floating-widget calendar-widget hidden">
                <div class="widget-header">
                    <div class="title-container">
                        <h3>Calendario</h3>
                    </div>
                    <div class="header-actions">
                        <button class="close-btn" onclick="cerrarCalendario()" title="Cerrar">&times;</button>
                    </div>
                </div>

                <div class="calendar-controls">
                    <select id="calendar-month" aria-label="Mes del calendario"></select>
                    <input id="calendar-year" type="number" min="2006" step="1" aria-label="Año del calendario" />
                </div>

                <div class="calendar-weekdays">
                </div>

                <div id="calendar-grid" class="calendar-grid"></div>
            </div>
        </div>
    </main>

    <!-- Estructura HTML limpia para el Tour -->

    <div id="tour-overlay" class="tour-overlay" data-usuario="@(usuario?.Id.ToString() ?? "invitado")"></div>
        <div id="tour-card" class="tour-card hidden">
        <h3 id="tour-titulo">Paso del Tour</h3>
        <p id="tour-descripcion">Descripción del paso actual.</p>
        <div class="tour-botones">
            <button class="btn-saltear" onclick="saltearTour()">Saltear</button>
            <div class="tour-acciones-pasos">
                <button id="btn-anterior-tour" class="btn-anterior hidden" onclick="pasoAnterior()">Anterior</button>
                <button class="btn-entendido" onclick="siguientePaso()">Entendido</button>
            </div>
        </div>
    </div>

    <!-- Script del cliente -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/Calendario.js"></script>
    <script>
        function toggleWorkspaceUserMenu() {
            const menu = document.getElementById('workspaceUserMenu');
            if (!menu) return;
            menu.classList.toggle('open');
        }

        function toggleWorkspaceSidebar() {
            const button = document.getElementById('toggle-workspace-sidebar');
            const sidebar = document.getElementById('workspace-sidebar');
            const isExpanded = document.body.classList.toggle('workspace-sidebar-collapsed') === false;
            button.setAttribute('aria-expanded', String(isExpanded));
            button.setAttribute('aria-label', isExpanded ? 'Ocultar menú lateral' : 'Mostrar menú lateral');
            button.title = isExpanded ? 'Ocultar menú lateral' : 'Mostrar menú lateral';
            button.textContent = isExpanded ? '‹' : '›';
            sidebar.setAttribute('aria-hidden', String(!isExpanded));
        }

        document.addEventListener('click', function (event) {
            const menu = document.getElementById('workspaceUserMenu');
            const button = document.querySelector('.workspace-user-button');
            if (!menu || !button) return;
            if (!menu.contains(event.target) && !button.contains(event.target)) {
                menu.classList.remove('open');
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            const widget = document.getElementById('calendar-widget');
            if (widget) {
                widget.style.left = '40px';
                widget.style.top = '40px';
            }
        });

        window.calendarEventosRaw = @Html.Raw(eventosJson);
    </script>
</body>
</html>