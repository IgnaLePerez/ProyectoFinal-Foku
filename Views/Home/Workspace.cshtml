@{
    ViewData["Title"] = "Foku";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foku App</title>
    <style>
        :root {
            --bg-color: #f2f2f2;
            --pill-bg: #f4f1ea;
            --pill-border: #e2ddd3;
            --text-color: #1a1a1a;
            --text-muted: #666666;
            --accent-orange: #f38b00;
            --accent-fire: #d9531e;
            --modal-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 24px;
            position: relative;
        }

        /* BARRA SUPERIOR */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        /* LOGO */
        .logo-pill {
            background-color: var(--pill-bg);
            padding: 12px 28px 12px 16px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .logo-icon {
            width: 42px;
            height: 42px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-c {
            width: 32px;
            height: 32px;
            border: 4.5px solid #1a1a1a;
            border-right-color: transparent;
            border-radius: 50%;
            transform: rotate(-35deg);
        }

        .logo-dot {
            width: 9px;
            height: 9px;
            background-color: var(--accent-orange);
            border-radius: 50%;
            position: absolute;
            top: 17px;
            left: 20px;
        }

        .logo-text {
            font-size: 32px;
            font-weight: 500;
            letter-spacing: -0.5px;
        }

        /* PERFIL Y RACHA */
        .user-pill {
            background-color: var(--pill-bg);
            padding: 10px 18px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .streak-container {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 22px;
            font-weight: 600;
        }

        .fire-icon {
            width: 22px;
            height: 26px;
            fill: var(--text-color);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
        }

        .user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 2px solid var(--text-color);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-avatar svg {
            width: 16px;
            height: 16px;
            fill: var(--text-color);
        }

        .dropdown-arrow {
            width: 0;
            height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-top: 5px solid var(--text-color);
            margin-left: 2px;
        }

        /* LAYOUT PRINCIPAL Y MENÚ LATERAL */
        .main-container {
            display: flex;
            margin-top: 40px;
            flex: 1;
            position: relative;
        }

        .sidebar-pill {
            background-color: var(--pill-bg);
            padding: 24px 12px;
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            gap: 28px;
            align-self: flex-start;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            width: 80px;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none;
            color: var(--text-color);
            cursor: pointer;
            padding: 8px 4px;
            border-radius: 12px;
            transition: background-color 0.2s ease;
        }

        .nav-item:hover {
            background-color: rgba(0, 0, 0, 0.04);
        }

        .nav-item.active {
            font-weight: 600;
        }

        .nav-item svg {
            width: 28px;
            height: 28px;
            stroke: currentColor;
            stroke-width: 1.8;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .nav-item span {
            font-size: 11px;
            font-weight: 600;
        }

        /* CONTENIDO PRINCIPAL */
        .content-area {
            flex: 1;
            padding: 0 40px;
        }

        /* OVERLAY Y MODAL POMODORO */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .pomodoro-card {
            background-color: var(--pill-bg);
            width: 100%;
            max-width: 480px;
            border-radius: 24px;
            padding: 28px 32px 32px 32px;
            box-shadow: var(--modal-shadow);
            position: relative;
            transform: translateY(10px);
            transition: transform 0.25s ease;
        }

        .modal-overlay.active .pomodoro-card {
            transform: translateY(0);
        }

        /* HEADER DEL MODAL */
        .pomodoro-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(0,0,0,0.12);
            position: relative;
        }

        .title-group {
            display: flex;
            align-items: center;
            gap: 8px;
            position: relative;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .pomodoro-title {
            font-size: 26px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px;
            border-radius: 50%;
            transition: opacity 0.2s;
        }

        .icon-btn:hover {
            opacity: 0.7;
        }

        .info-btn {
            color: #4a6fa5;
        }

        .info-btn svg {
            width: 20px;
            height: 20px;
        }

        .close-btn svg, .config-btn svg {
            width: 22px;
            height: 22px;
            stroke-width: 2;
        }

        /* TOOLTIP EXPLICATIVO (HOVER) */
        .tooltip-popover {
            position: absolute;
            top: -75px;
            left: 20px;
            background-color: var(--pill-bg);
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 8px;
            padding: 10px 14px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.1);
            width: 310px;
            font-size: 13.5px;
            color: #4a4a4a;
            line-height: 1.35;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.2s ease, transform 0.2s ease;
            transform: translateY(4px);
            z-index: 10;
        }

        .tooltip-popover::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 112px;
            width: 10px;
            height: 10px;
            background-color: var(--pill-bg);
            border-right: 1px solid rgba(0,0,0,0.08);
            border-bottom: 1px solid rgba(0,0,0,0.08);
            transform: rotate(45deg);
        }

        .info-btn:hover + .tooltip-popover {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* BODY DEL POMODORO */
        .pomodoro-body {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 20px;
        }

        .timer-display {
            font-size: 82px;
            font-weight: 500;
            letter-spacing: -2px;
            line-height: 1;
            color: #1f1f1f;
        }

        .timer-controls-vertical {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .action-btn {
            background-color: #212429;
            color: #ffffff;
            border: none;
            padding: 12px 28px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.1s ease;
            text-align: center;
        }

        .action-btn:hover {
            background-color: #34383e;
        }

        .action-btn:active {
            transform: scale(0.98);
        }

        .reset-btn {
            background-color: transparent;
            color: #444444;
            border: 1.5px solid #d0c9bd;
            padding: 10px 28px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
        }

        .reset-btn:hover {
            background-color: rgba(0, 0, 0, 0.05);
            color: #1a1a1a;
            border-color: #a0988a;
        }

        .reset-btn:active {
            transform: scale(0.98);
        }

        /* PANEL DE CONFIGURACIÓN DE TIEMPOS */
        .config-panel {
            display: none;
            margin-top: 20px;
            padding: 18px;
            background-color: rgba(0, 0, 0, 0.03);
            border-radius: 16px;
            border: 1px solid rgba(0,0,0,0.06);
        }

        .config-panel.open {
            display: block;
        }

        .config-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 12px;
            color: #333;
        }

        .config-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 13.5px;
            color: #555;
        }

        .config-row:last-child {
            margin-bottom: 0;
        }

        .config-inputs {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .config-input-group {
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .config-inputs input {
            width: 48px;
            padding: 4px 6px;
            border: 1px solid #ccc;
            border-radius: 6px;
            text-align: center;
            font-size: 13.5px;
            background-color: #fff;
        }

        .config-inputs span {
            font-size: 12px;
            color: #777;
        }

        /* INFO DEL PRÓXIMO CICLO Y SEGUIMIENTO DE CICLOS */
        .next-cycle-info {
            margin-top: 24px;
            color: #666666;
            font-size: 15px;
            font-weight: 500;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cycle-count-badge {
            font-size: 12px;
            background-color: rgba(0, 0, 0, 0.06);
            padding: 4px 10px;
            border-radius: 12px;
            color: #444;
            font-weight: 600;
        }

        /* MODOS DE TRABAJO (TABS) */
        .pomodoro-modes {
            display: flex;
            gap: 24px;
            margin-top: 18px;
        }

        .mode-btn {
            background: none;
            border: none;
            font-size: 16px;
            color: #2b2b2b;
            cursor: pointer;
            padding-bottom: 4px;
            position: relative;
            font-weight: 500;
        }

        .mode-btn.active {
            font-weight: 600;
        }

        .mode-btn.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: #1a1a1a;
            border-radius: 2px;
        }
    </style>
</head>
<body>

    <!-- BARRA SUPERIOR -->
    <header class="top-bar">
        <div class="logo-pill">
            <div class="logo-icon">
                <div class="logo-c"></div>
                <div class="logo-dot"></div>
            </div>
            <span class="logo-text">Foku</span>
        </div>

        <div class="user-pill">
            <div class="streak-container">
                <span>67</span>
                <svg class="fire-icon" viewBox="0 0 24 24">
                    <path d="M12 23c4.97 0 9-3.58 9-8 0-4.19-3.23-7.6-7-8.8-1.04-.33-2.07.52-1.92 1.6.14 1.02-.19 2.05-.88 2.81C10.3 11.61 9 13.06 9 15c0 .55-.45 1-1 1s-1-.45-1-1c0-2.88 1.83-5.26 4.31-6.22C11.63 8.65 12 8.35 12 8c0-.38-.26-.71-.63-.78C8.17 6.55 5 9.77 5 13.5 5 18.75 8.13 23 12 23z"/>
                </svg>
            </div>
            <div class="user-profile">
                <div class="user-avatar">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                </div>
                <span>Nombre de Usuario</span>
                <div class="dropdown-arrow"></div>
            </div>
        </div>
    </header>

    <!-- ÁREA PRINCIPAL -->
    <div class="main-container">
        <!-- MENÚ LATERAL -->
        <nav class="sidebar-pill">
            <a class="nav-item" onclick="switchTab('documentos')">
                <svg viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <line x1="10" y1="9" x2="8" y2="9"></line>
                </svg>
                <span>Documentos</span>
            </a>

            <a class="nav-item active" onclick="openPomodoro()">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="13" r="8"></circle>
                    <polyline points="12 9 12 13 14 14"></polyline>
                    <path d="M5 3L2 6"></path>
                    <path d="M19 3l3 3"></path>
                    <path d="M12 2v2"></path>
                </svg>
                <span>Pomodoro</span>
            </a>

            <a class="nav-item" onclick="switchTab('tareas')">
                <svg viewBox="0 0 24 24">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
                <span>Tareas</span>
            </a>

            <a class="nav-item" onclick="switchTab('calendario')">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>Calendario</span>
            </a>
        </nav>

        <main class="content-area"></main>
    </div>

    <!-- POP-UP MODAL DEL POMODORO -->
    <div class="modal-overlay" id="pomodoroModal" onclick="closePomodoroOnOverlay(event)">
        <div class="pomodoro-card">
            
            <div class="pomodoro-header">
                <div class="title-group">
                    <span class="pomodoro-title">Pomodoro</span>
                    <button class="icon-btn info-btn" title="Información">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17" stroke-width="3"></line>
                        </svg>
                    </button>
                    <!-- Tooltip sobre la técnica Pomodoro (Hover) -->
                    <div class="tooltip-popover">
                        El pomodoro es una técnica donde hay 25 minutos de concentración y 5 minutos de descanso
                    </div>
                </div>

                <div class="header-actions">
                    <button class="icon-btn config-btn" onclick="toggleConfigPanel()" title="Personalizar tiempos">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </button>
                    <button class="icon-btn close-btn" onclick="closePomodoro()" title="Cerrar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- PANEL DE CONFIGURACIÓN PERSONALIZADA DE TIEMPOS -->
            <div class="config-panel" id="configPanel">
                <div class="config-title">Personalizar Tiempos</div>
                
                <div class="config-row">
                    <span>Concentración:</span>
                    <div class="config-inputs">
                        <div class="config-input-group">
                            <input type="number" id="input-conc-min" value="0" min="0" max="99" onchange="updateCustomDurations()">
                            <span>m</span>
                        </div>
                        <div class="config-input-group">
                            <input type="number" id="input-conc-sec" value="25" min="0" max="59" onchange="updateCustomDurations()">
                            <span>s</span>
                        </div>
                    </div>
                </div>

                <div class="config-row">
                    <span>Pausa corta:</span>
                    <div class="config-inputs">
                        <div class="config-input-group">
                            <input type="number" id="input-pcorta-min" value="0" min="0" max="99" onchange="updateCustomDurations()">
                            <span>m</span>
                        </div>
                        <div class="config-input-group">
                            <input type="number" id="input-pcorta-sec" value="5" min="0" max="59" onchange="updateCustomDurations()">
                            <span>s</span>
                        </div>
                    </div>
                </div>

                <div class="config-row">
                    <span>Pausa larga:</span>
                    <div class="config-inputs">
                        <div class="config-input-group">
                            <input type="number" id="input-plarga-min" value="0" min="0" max="99" onchange="updateCustomDurations()">
                            <span>m</span>
                        </div>
                        <div class="config-input-group">
                            <input type="number" id="input-plarga-sec" value="15" min="0" max="59" onchange="updateCustomDurations()">
                            <span>s</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pomodoro-body">
                <div class="timer-display" id="timerDisplay">00:25</div>
                <div class="timer-controls-vertical">
                    <button class="action-btn" id="startBtn" onclick="toggleTimer()">Empezar</button>
                    <button class="reset-btn" id="resetBtn" onclick="resetAll()">Reiniciar</button>
                </div>
            </div>

            <div class="next-cycle-info">
                <span id="nextCycleText">Próximo ciclo: 5 segundos de descanso</span>
                <span class="cycle-count-badge" id="cycleBadge">Ciclo #1</span>
            </div>

            <div class="pomodoro-modes">
                <button class="mode-btn active" id="mode-concentracion" onclick="changeModeManual('concentracion')">Concentración</button>
                <button class="mode-btn" id="mode-pausa-corta" onclick="changeModeManual('pausa-corta')">Pausa corta</button>
                <button class="mode-btn" id="mode-pausa-larga" onclick="changeModeManual('pausa-larga')">Pausa larga</button>
            </div>
        </div>
    </div>

    <script>
        let timer = null;
        let isRunning = false;
        let currentMode = 'concentracion';
        let pomodoroCount = 0;

        // Configuración de duraciones base por modo
        let modesConfig = {
            'concentracion': { min: 0, sec: 25 },
            'pausa-corta': { min: 0, sec: 5 },
            'pausa-larga': { min: 0, sec: 15 }
        };

        // Estado del tiempo restante para cada modo (preserva el avance si navegas entre ellos)
        let modeState = {
            'concentracion': getModeSeconds('concentracion'),
            'pausa-corta': getModeSeconds('pausa-corta'),
            'pausa-larga': getModeSeconds('pausa-larga')
        };

        function getModeSeconds(mode) {
            return (modesConfig[mode].min * 60) + modesConfig[mode].sec;
        }

        function formatDurationText(min, sec) {
            let parts = [];
            if (min > 0) parts.push(`${min} minuto${min > 1 ? 's' : ''}`);
            if (sec > 0 || min === 0) parts.push(`${sec} segundo${sec !== 1 ? 's' : ''}`);
            return parts.join(' y ');
        }

        function openPomodoro() {
            document.getElementById('pomodoroModal').classList.add('active');
        }

        function closePomodoro() {
            document.getElementById('pomodoroModal').classList.remove('active');
        }

        function closePomodoroOnOverlay(event) {
            if (event.target.classList.contains('modal-overlay')) {
                closePomodoro();
            }
        }

        function toggleConfigPanel() {
            const panel = document.getElementById('configPanel');
            panel.classList.toggle('open');
        }

        function updateCustomDurations() {
            modesConfig['concentracion'].min = parseInt(document.getElementById('input-conc-min').value) || 0;
            modesConfig['concentracion'].sec = parseInt(document.getElementById('input-conc-sec').value) || 0;

            modesConfig['pausa-corta'].min = parseInt(document.getElementById('input-pcorta-min').value) || 0;
            modesConfig['pausa-corta'].sec = parseInt(document.getElementById('input-pcorta-sec').value) || 0;

            modesConfig['pausa-larga'].min = parseInt(document.getElementById('input-plarga-min').value) || 0;
            modesConfig['pausa-larga'].sec = parseInt(document.getElementById('input-plarga-sec').value) || 0;

            // Si el temporizador no está corriendo, actualizamos las reservas de tiempo y la vista
            if (!isRunning) {
                modeState['concentracion'] = getModeSeconds('concentracion');
                modeState['pausa-corta'] = getModeSeconds('pausa-corta');
                modeState['pausa-larga'] = getModeSeconds('pausa-larga');
                updateDisplay();
            }
            updateNextCycleText();
        }

        function updateDisplay() {
            const currentSeconds = modeState[currentMode];
            const minutes = Math.floor(currentSeconds / 60);
            const seconds = currentSeconds % 60;
            document.getElementById('timerDisplay').textContent = 
                `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function toggleTimer() {
            const btn = document.getElementById('startBtn');
            if (isRunning) {
                clearInterval(timer);
                isRunning = false;
                btn.textContent = 'Empezar';
            } else {
                isRunning = true;
                btn.textContent = 'Pausar';
                timer = setInterval(() => {
                    if (modeState[currentMode] > 0) {
                        modeState[currentMode]--;
                        updateDisplay();
                    } else {
                        clearInterval(timer);
                        handleCycleCompletion();
                    }
                }, 1000);
            }
        }

        // Reinicia tanto el tiempo del modo actual como los ciclos completos
        function resetAll() {
            if (isRunning) {
                clearInterval(timer);
                isRunning = false;
                document.getElementById('startBtn').textContent = 'Empezar';
            }
            // Restablece los tiempos de todos los modos
            modeState['concentracion'] = getModeSeconds('concentracion');
            modeState['pausa-corta'] = getModeSeconds('pausa-corta');
            modeState['pausa-larga'] = getModeSeconds('pausa-larga');

            // Reinicia los ciclos a cero
            pomodoroCount = 0;
            document.getElementById('cycleBadge').textContent = `Ciclo #1`;

            updateNextCycleText();
            updateDisplay();
        }

        function handleCycleCompletion() {
            // Reinicia la reserva de tiempo del modo que acaba de finalizar para su próximo uso
            modeState[currentMode] = getModeSeconds(currentMode);

            if (currentMode === 'concentracion') {
                pomodoroCount++;
                if (pomodoroCount % 4 === 0) {
                    setMode('pausa-larga', true);
                } else {
                    setMode('pausa-corta', true);
                }
            } else {
                setMode('concentracion', true);
            }

            // Inicia automáticamente el temporizador del siguiente ciclo
            isRunning = true;
            document.getElementById('startBtn').textContent = 'Pausar';
            timer = setInterval(() => {
                if (modeState[currentMode] > 0) {
                    modeState[currentMode]--;
                    updateDisplay();
                } else {
                    clearInterval(timer);
                    handleCycleCompletion();
                }
            }, 1000);
        }

        function updateNextCycleText() {
            const nextTextElem = document.getElementById('nextCycleText');
            if (currentMode === 'concentracion') {
                const nextIsLong = (pomodoroCount + 1) % 4 === 0;
                const modeTarget = nextIsLong ? 'pausa-larga' : 'pausa-corta';
                const durText = formatDurationText(modesConfig[modeTarget].min, modesConfig[modeTarget].sec);
                nextTextElem.textContent = `Próximo ciclo: ${durText} de ${nextIsLong ? 'pausa larga' : 'descanso'}`;
            } else {
                const durText = formatDurationText(modesConfig['concentracion'].min, modesConfig['concentracion'].sec);
                nextTextElem.textContent = `Próximo ciclo: ${durText} de concentración`;
            }
        }

        function setMode(mode, autoTransition = false) {
            currentMode = mode;

            // Si es una transición manual y la reserva de tiempo de este modo es 0, la restablecemos a la duración base
            if (!autoTransition && modeState[mode] <= 0) {
                modeState[mode] = getModeSeconds(mode);
            }

            document.querySelectorAll('.mode-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`mode-${mode}`).classList.add('active');

            updateNextCycleText();
            document.getElementById('cycleBadge').textContent = `Ciclo #${pomodoroCount + 1}`;

            updateDisplay();
        }

        function changeModeManual(mode) {
            // Al cambiar manualmente entre solapas, pausable el reloj si corría pero PRESERVA el progreso exacto
            if (isRunning) {
                clearInterval(timer);
                isRunning = false;
                document.getElementById('startBtn').textContent = 'Empezar';
            }
            setMode(mode, false);
        }

        function switchTab(tabName) {
            document.querySelectorAll('.sidebar-pill .nav-item').forEach(item => {
                item.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
        }

        window.onload = () => {
            openPomodoro();
            updateDisplay();
        };
    </script>
</body>
</html>